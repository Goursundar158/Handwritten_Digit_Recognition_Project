{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Full Project",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Generate Documentation",
      "type": "debugpy",
      "request": "launch",
      "module": "docs.make_documentation",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Predict Sample Digit",
      "type": "debugpy",
      "request": "launch",
      "module": "src.predict",
      "args": [
        "--image",
        "data/samples/digit_8_degraded.png"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Predict Sample Form",
      "type": "debugpy",
      "request": "launch",
      "module": "src.predict_form",
      "args": [
        "--image",
        "data/samples/form_3014.png",
        "--save-figure"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Run Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
